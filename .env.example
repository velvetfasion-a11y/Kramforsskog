# Copy to .env for local development (never commit .env)

# Exactly 32 characters
PB_ENCRYPTION_KEY=01234567890123456789012345678901
PB_SUPERUSER_EMAIL=admin@kramforsskog.local
PB_SUPERUSER_PASSWORD=changeme-local-admin

# Optional: only needed if testing production API URL locally
# VITE_POCKETBASE_URL=https://your-api.onrender.com

# EmailJS (contact form) — Public Key from https://dashboard.emailjs.com/admin/account
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
